{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "wayfinder:generate": "php artisan wayfinder:generate --no-interaction && node scripts/scrub-nosync.mjs",
        "wayfinder:check": "npm run wayfinder:generate && git diff --exit-code -- resources/js/actions resources/js/routes resources/js/wayfinder",
        "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true; test -f scripts/nosync-relink.mjs && node scripts/nosync-relink.mjs || true"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.66.0"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.6.1",
        "@lucide/vue": "^1.30.0",
        "@tailwindcss/forms": "^0.5.3",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.3.0",
        "@vueuse/integrations": "^14.3.0",
        "autoprefixer": "^10.4.20",
        "browserslist": "^4.28.2",
        "caniuse-lite": "^1.0.30001793",
        "chart.js": "^4.5.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.4",
        "laravel-vite-plugin": "^3.1.3",
        "playwright": "1.62.1",
        "radix-vue": "^1.9.11",
        "sortablejs": "^1.15.7",
        "tailwind-merge": "^2.6.1",
        "tailwindcss": "^3.4.1",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.2.2",
        "vite": "^8.2.1",
        "vue": "^3.5.13",
        "vue-chartjs": "^5.3.3",
        "vue-tsc": "^3.3.9"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
